{
  "name": "social-icons-webfont",
  "version": "1.49.1",
  "description": "Icon font containing social media branding icons",
  "main": "style.css",
  "files": [
    "fonts",
    "svgs",
    "React",
    "Vue",
    "style.css",
    "variables.scss",
    "icons.js",
    "icons.d.ts",
    "hostnames.js",
    "hostnames.d.ts"
  ],
  "exports": {
    ".": "./style.css",
    "./style.css": "./style.css",
    "./variables.scss": "./variables.scss",
    "./react": "./React/icons.jsx",
    "./vue/*": "./Vue/*",
    "./icons": {
      "types": "./icons.d.ts",
      "default": "./icons.js"
    },
    "./icons.js": {
      "types": "./icons.d.ts",
      "default": "./icons.js"
    },
    "./hostnames": {
      "types": "./hostnames.d.ts",
      "default": "./hostnames.js"
    },
    "./hostnames.js": {
      "types": "./hostnames.d.ts",
      "default": "./hostnames.js"
    },
    "./fonts/*": "./fonts/*",
    "./svgs/*": "./svgs/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boylett/social-icons-webfont.git"
  },
  "scripts": {
    "gen": "node ./gen.js",
    "version": "node ./sync-version.js && git add README.md"
  },
  "keywords": [
    "social",
    "brands",
    "icons",
    "webfont"
  ],
  "author": "Ryan Boylett",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/boylett/social-icons-webfont/issues"
  },
  "homepage": "https://boylett.github.io/social-icons-webfont/demo.html",
  "type": "module"
}
