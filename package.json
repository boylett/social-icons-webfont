{
  "name": "social-icons-webfont",
  "version": "2.1.1",
  "description": "Icon font containing social media branding icons",
  "main": "style.css",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "fonts",
    "svgs",
    "React/icons.js",
    "React/icons.d.ts",
    "Vue",
    "style.css",
    "variables.scss",
    "icons.js",
    "icons.d.ts",
    "hostnames.js",
    "hostnames.d.ts",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./style.css",
    "./style.css": "./style.css",
    "./variables.scss": "./variables.scss",
    "./react": {
      "types": "./React/icons.d.ts",
      "default": "./React/icons.js"
    },
    "./vue/*": "./Vue/*",
    "./icons": {
      "types": "./icons.d.ts",
      "default": "./icons.js"
    },
    "./icons.js": {
      "types": "./icons.d.ts",
      "default": "./icons.js"
    },
    "./hostnames": {
      "types": "./hostnames.d.ts",
      "default": "./hostnames.js"
    },
    "./hostnames.js": {
      "types": "./hostnames.d.ts",
      "default": "./hostnames.js"
    },
    "./fonts/*": "./fonts/*",
    "./svgs/*": "./svgs/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boylett/social-icons-webfont.git"
  },
  "scripts": {
    "gen": "node ./gen.js",
    "build": "node ./gen.js && esbuild React/icons.jsx --outfile=React/icons.js --format=esm --jsx=automatic",
    "prepublishOnly": "npm run build",
    "version": "node ./sync-version.js && git add README.md"
  },
  "keywords": [
    "social",
    "brands",
    "icons",
    "webfont"
  ],
  "author": "Ryan Boylett",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/boylett/social-icons-webfont/issues"
  },
  "homepage": "https://boylett.github.io/social-icons-webfont/demo.html",
  "type": "module",
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
